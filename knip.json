{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "packages/ci-perf-lint/**",
    "test/fixtures/**",
    "test/arbitraries/index.ts"
  ],
  "ignoreBinaries": [
    "hyperfine",
    "rg"
  ],
  "ignoreDependencies": [
    "@codspeed/core",
    "tsrs"
  ],
  "ignoreIssues": {
    "src/repository-similar-workflows-similarity.ts": [
      "exports"
    ],
    "src/rules/shared/similar-workflow-consensus-consensus.ts": [
      "exports"
    ],
    "src/rules/shared/evidence-propagation.ts": [
      "exports"
    ],
    "src/mutation/harness-runtime.ts": [
      "exports"
    ]
  },
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "bench/**/*.bench.ts",
        "bench/run.ts",
        "bench/source-memory/run.ts",
        "fuzz/**/*.mjs",
        "test/**/*.test.ts",
        "stryker/stryker.*.config.mjs",
        "src/mutation/harness-child.ts",
        "src/fuzz/worker.ts"
      ]
    },
    "site": {
      "entry": [
        "public/site.js"
      ]
    },
    "formal": {}
  }
}
