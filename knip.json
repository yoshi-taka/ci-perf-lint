{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["packages/ci-perf-lint/**", "test/fixtures/**", "test/arbitraries/index.ts"],
  "ignoreBinaries": ["hyperfine", "rg"],
  "ignoreDependencies": ["@codspeed/core", "@stryker-mutator/command-runner", "tsrs"],
  "ignoreIssues": {
    "src/repository-similar-workflows-similarity.ts": ["exports"],
    "src/rules/shared/similar-workflow-consensus-consensus.ts": ["exports"],
    "src/rules/shared/evidence-propagation.ts": ["exports"]
  },
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "bench/**/*.bench.ts",
        "bench/run.ts",
        "bench/source-memory/run.ts",
        "stryker/stryker.source-*.config.mjs",
        "fuzz/**/*.mjs",
        "test/**/*.test.ts"
      ]
    },
    "site": {
      "entry": ["src/pages/**/*.astro", "src/layouts/**/*.astro"]
    },
    "formal": {}
  }
}
