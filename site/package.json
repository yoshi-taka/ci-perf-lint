{
  "name": "ci-perf-lint-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch serve.ts --watch",
    "build": "bun run build.ts",
    "og:prototype": "bun run prototype-og.ts",
    "preview": "bun run serve.ts",
    "test": "AGENT=1 bun --no-orphans ../scripts/run-bounded.ts --memory-mib 2048 --timeout-ms 180000 -- bun test --no-orphans --parallel=2 --no-isolate --randomize ../test/site-*.test.ts"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
