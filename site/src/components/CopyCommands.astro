---
interface Props {
  commands: string[];
  note?: string;
  label?: string;
}
const {
  commands,
  note = "Run from your repository. No configuration required.",
  label = "Try from your repository root",
} = Astro.props;
---
<div data-copy-group>
  <div class="hero-commands" aria-label={label}>
    {commands.map((command) => (
      <div>
        <span class="command-prompt" aria-hidden="true">$</span>
        <code>{command}</code>
        <button type="button" data-copy-command={command} aria-label={`Copy ${command}`} hidden>Copy <span aria-hidden="true">⧉</span></button>
      </div>
    ))}
  </div>
  <p class="fine-print" data-copy-status role="status">{note}</p>
</div>
<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-command]")) {
    button.hidden = false;
    button.addEventListener("click", async () => {
      const text = button.dataset.copyCommand;
      const status = button.closest("[data-copy-group]")?.querySelector("[data-copy-status]");
      if (!text || !status) return;
      try {
        await navigator.clipboard.writeText(text);
        status.textContent = `Copied: ${text}`;
      } catch {
        status.textContent = "Select the command above to copy it manually.";
      }
    });
  }
</script>
