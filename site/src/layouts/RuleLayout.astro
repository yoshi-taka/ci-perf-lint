---
import BaseLayout from "./BaseLayout.astro";
import { withBase } from "../lib/urls";

const { frontmatter, headings: allHeadings } = Astro.props;
const headings = allHeadings.filter((heading: { depth: number }) => heading.depth === 2 || heading.depth === 3);
const title = frontmatter.title.replace(/`/g, "");
const guide = frontmatter.kind === "guide";
const slug = Astro.url.pathname.split("/").filter(Boolean).at(-1);
const sourcePath = guide ? `docs/${slug}.md` : `docs/rules/${slug}.md`;
---
<BaseLayout title={`${title} | ci-perf-lint`} description={`${title}: detection criteria, context, and verification guidance for ci-perf-lint.`}>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={withBase("/")}>Home</a><span aria-hidden="true">/</span>
      <a href={withBase("/rules/")}>Rules</a><span aria-hidden="true">/</span>
      <span>{guide ? "Guide" : "Rule documentation"}</span>
    </nav>
    <div class="docs-layout">
      <article class="doc">
        <div class="doc-label">
          <span class="doc-kind-mark" aria-hidden="true"></span>
          <p class="eyebrow">{guide ? "Detection guide" : "Rule reference"}</p>
          <a href={`https://github.com/yoshi-taka/ci-perf-lint/blob/main/${sourcePath}`}>View source <span aria-hidden="true">↗</span></a>
        </div>
        <div class="doc-content"><slot /></div>
        <div class="doc-tools">
          <a href={withBase("/rules/")}>← All rules</a>
          <a href={`https://github.com/yoshi-taka/ci-perf-lint/blob/main/${sourcePath}`}>View source ↗</a>
        </div>
      </article>
      <aside class:list={["doc-sidebar", { "has-toc": headings.length > 0 }]} aria-label="Page navigation">
        {headings.length > 0 && (
          <Fragment>
            <p class="eyebrow">On this page</p>
            <ol>{headings.map((heading: { depth: number; slug: string; text: string }, index: number) => (
              <li class:list={{ "toc-sub": heading.depth === 3 }}><a href={`#${heading.slug}`}><span class="toc-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><span>{heading.text}</span></a></li>
            ))}</ol>
          </Fragment>
        )}
        <div class="sidebar-run">
          <p class="eyebrow">Try it locally</p>
          <code>npx ci-perf-lint</code>
          <p class="sidebar-note">Run from your repository. No configuration required.</p>
        </div>
        <a class="sidebar-link" href={withBase("/rules/")}>Browse all rules ↗</a>
        <p class="sidebar-note sidebar-caveat">Static analysis finds opportunities, not guaranteed savings. Review changes and measure their effect.</p>
      </aside>
    </div>
  </div>
</BaseLayout>
