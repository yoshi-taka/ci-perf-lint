---
import { withBase } from "../lib/urls";

interface Props {
  title: string;
  description?: string;
  home?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = "Scan CI workflows, source code, and tooling configuration for avoidable work.",
  home = false,
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="stylesheet" href={withBase("/site.css")} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href={withBase("/")} aria-label="ci-perf-lint home">
        <span class="brand-icon" aria-hidden="true"></span> ci-perf-lint
      </a>
      <nav aria-label="Main navigation">
        {home && <a href="#how-it-works">How it works</a>}
        <a href={withBase("/rules/")} aria-current={Astro.url.pathname === withBase("/rules/") ? "page" : undefined}>Rules</a>
        <a href="https://github.com/yoshi-taka/ci-perf-lint">GitHub</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <a class="brand" href={withBase("/")}>ci-perf-lint</a>
      <p>Static analysis for CI performance.</p>
      <div>
        <a href="https://github.com/yoshi-taka/ci-perf-lint">Source</a>
        <a href="https://www.npmjs.com/package/ci-perf-lint">npm</a>
      </div>
    </footer>
  </body>
</html>
