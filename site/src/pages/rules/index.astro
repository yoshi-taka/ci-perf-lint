---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listRuleDocs } from "../../lib/rules";
import { withBase } from "../../lib/urls";

const rules = await listRuleDocs();
---
<BaseLayout title="Performance checks | ci-perf-lint" description="Browse ci-perf-lint checks for workflows, Docker builds, source code, and tooling. Find detection criteria, suggested changes, and verification guidance.">
  <div class="wrap">
    <section class="docs-intro">
      <p class="eyebrow">Index / Rules</p>
      <h1>Performance checks.</h1>
      <p>What each rule detects, why it matters, what to change, and how to verify the result. Individual rule coverage varies by CI platform.</p>
    </section>
    <section class="docs-list" aria-label="All performance rules">
      <div class="rule-controls">
        <p class="mono" data-rule-count role="status">{rules.length} documented rules</p>
        <label class="search" hidden data-search-control>
          <span aria-hidden="true">⌕</span><span class="sr-only">Search all rules</span>
          <input type="search" data-rule-search placeholder="Search rules…" autocomplete="off" />
        </label>
      </div>
      <div class="rule-list">
        {rules.map((rule, index) => (
          <a class="rule-row" data-rule href={withBase(`/rules/${rule.slug}/`)}>
            <span class="rule-index" aria-hidden="true">{String(index + 1).padStart(3, "0")}</span>
            <span class="rule-entry"><h2>{rule.title}</h2><p>{rule.summary}</p></span>
          </a>
        ))}
      </div>
      <p data-no-rules hidden>No matching rules. Try a tool name, a rule ID, or a term such as “cache”.</p>
    </section>
  </div>
</BaseLayout>
<script>
  const search = document.querySelector<HTMLInputElement>("[data-rule-search]");
  const control = document.querySelector<HTMLElement>("[data-search-control]");
  const count = document.querySelector("[data-rule-count]");
  const empty = document.querySelector<HTMLElement>("[data-no-rules]");
  const rules = [...document.querySelectorAll<HTMLElement>("[data-rule]")];
  const texts = rules.map((rule) => rule.textContent?.toLowerCase() ?? "");
  if (search && control && count && empty) {
    control.hidden = false;
    search.addEventListener("input", () => {
      const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let visible = 0;
      rules.forEach((rule, index) => {
        const matches = terms.every((term) => texts[index].includes(term));
        rule.hidden = !matches;
        if (matches) visible += 1;
      });
      count.textContent = `${visible} of ${rules.length} documented rules`;
      empty.hidden = visible !== 0;
    });
  }
</script>
