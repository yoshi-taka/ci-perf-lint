{
  "name": "@yoshi-taka/ci-perf-lint",
  "version": "1.3.0",
  "description": "Static analysis tool for CI workflow performance",
  "bin": {
    "ci-perf-lint": "./dist/cli.js"
  },
  "workspaces": [],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoshi-taka/ci-perf-lint.git"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "docs:sync": "bun run scripts/sync-docs-site.ts",
    "docs:dev": "bun run docs:sync && bun run astro dev --root site",
    "docs:build": "bun run docs:sync && bun run astro build --root site",
    "docs:preview": "bun run astro preview --root site",
    "test": "AGENT=1 bun test --parallel --timings=.bun-test-timings.json",
    "test:changed": "bun test --changed",
    "test:isolate": "bun test --isolate",
    "test:shell-evidence": "bun run test test/analyze-repository-shell-evidence-metamorphic.test.ts test/boundary-shell-evidence-metamorphic.test.ts test/boundary-shell-command-evidence.test.ts",
    "test:timings": "AGENT=1 bun test --parallel --timings=.bun-test-timings.json --update-timings",
    "test:fuzz:fast": "bun test --parallel test/fuzz-*.test.ts",
    "test:fuzz:jazzer": "bun build ./src/workflow.ts --outdir ./dist --target node --external oxlint --external oxc-parser && bun x jazzer fuzz/workflow.fuzz.mjs fuzz/corpus/workflow --sync",
    "test:slow:mutation": "bun run test:slow:mutation:rule-engine && bun run test:slow:mutation:workflow && bun run test:slow:mutation:core && bun run test:slow:mutation:repo && bun run test:slow:mutation:renderer && bun run test:slow:mutation:shell-evidence",
    "test:slow:mutation:core": "bun --bun stryker run stryker/stryker.core.config.mjs",
    "test:slow:mutation:smoke": "bun --bun stryker run stryker/stryker.core.config.mjs",
    "test:slow:mutation:workflow": "bun --bun stryker run stryker/stryker.workflow.config.mjs",
    "test:slow:mutation:repo": "bun --bun stryker run stryker/stryker.repo.config.mjs",
    "test:slow:mutation:rule-engine": "bun --bun stryker run stryker/stryker.rule-engine.config.mjs",
    "test:slow:mutation:renderer": "bun --bun stryker run stryker/stryker.renderer.config.mjs",
    "test:slow:mutation:shell-evidence": "bun --bun stryker run stryker/stryker.shell-evidence.config.mjs",
    "lint": "oxlint --type-aware --type-check --deny-warnings --fix src test && bun fmt src test/*.ts scripts/*.ts",
    "format": "bun fmt src test/*.ts scripts/*.ts",
    "format:check": "bun fmt --check src test/*.ts scripts/*.ts",
    "build": "bun build ./src/cli.ts --outdir ./dist --target node --external oxlint --external oxc-parser",
    "prepack": "bun run build",
    "cache:fixtures": "bun run scripts/cache-fixtures.ts",
    "new-rule": "bun run scripts/new-rule.ts",
    "generate-rule-docs": "bun run scripts/generate-rule-docs.ts",
    "check:rule-docs": "bun run scripts/generate-rule-docs.ts --check",
    "audit:package": "bun run build && bun run scripts/check-package-contents.ts",
    "reduce-workflow": "bun run scripts/reduce-workflow.ts",
    "coverage-matrix": "bun run scripts/rule-coverage-matrix.ts",
    "knip": "knip",
    "fallow": "fallow --production --skip health --skip dupes",
    "fallow:full": "fallow --production",
    "fallow:dead-code": "fallow dead-code --production",
    "unused": "bun run knip && bun run fallow:dead-code",
    "audit:static": "bun run knip && bun run fallow && bun run check:rule-docs",
    "release:alpha": "npm version prerelease --preid=alpha --no-git-tag-version && npm publish --access public --tag alpha && npm publish --prefix packages/ci-perf-lint --tag alpha",
    "release:stable": "npm version patch --no-git-tag-version && npm publish --access public && npm publish --prefix packages/ci-perf-lint",
    "perf:bench": "hyperfine --warmup 3 'bun run src/cli.ts'",
    "perf:flame": "bun --profile src/cli.ts",
    "perf:profile": "bun --cpu-prof --cpu-prof-dir .profile src/cli.ts",
    "perf:mem": "bun --heap-prof --heap-prof-dir .profile src/cli.ts",
    "setup-hooks": "lefthook install",
    "test:related": "bun run scripts/test-related.ts"
  },
  "dependencies": {
    "oxc-parser": "^0.155.0",
    "oxlint": "^1.92.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@codspeed/tinybench-plugin": "^6.1.1",
    "@jazzer.js/core": "^4.0.0",
    "@stryker-mutator/core": "^10.1.1",
    "astro": "^7.4.7",
    "bun-types": "^1.4.4",
    "fallow": "^3.40.0",
    "fast-check": "^4.10.2",
    "knip": "^6.44.2",
    "lefthook": "^2.2.2",
    "tinybench": "^6.2.3",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
